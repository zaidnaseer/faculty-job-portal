## Backend server
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority
MONGO_DB_NAME=your_database_name

## Auth
JWT_SECRET=replace_with_a_strong_random_secret
# Require a verified email (via Firebase) to log in / use protected routes.
# Leave unset or "false" for local development; set to "true" in production.
EMAIL_VERIFICATION_REQUIRED=false

# Single allowed frontend origin
FRONTEND_URL=http://localhost:5173
# Or allow multiple frontend origins
# FRONTEND_URLS=http://localhost:5173,https://your-frontend-domain.com

## Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

## Cloudflare R2 for applicant resumes and profile images
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name
